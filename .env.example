# ---- AI providers (set one or both; the router falls back automatically) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model IDs change over time. Check each provider's current model list and update these.
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5
ANTHROPIC_MODEL_OPUS=claude-opus-4-1
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
OPENAI_MODEL_MAIN=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
AI_REQUESTS_PER_MINUTE=20

# ---- Auth (Supabase). Leave empty for local dev (everyone is user "dev") ----
SUPABASE_JWT_SECRET=

# ---- Storage (optional S3-compatible mirror, e.g. Cloudflare R2) ----
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Pro-mode code execution. Only enable on an isolated worker/sandbox host ----
ENABLE_SANDBOX=0

# ---- Web (Vercel) ----
# API_URL=https://your-api.example.com
